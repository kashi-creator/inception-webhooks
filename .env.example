# Inception Emails — webhooks service env vars.
# Set these in Railway dashboard, never commit real values.

# GHL Private Integration Token for the Inception Emails sub-account.
# Source: GHL Private Integrations panel for `oPTc9Dv3gSsB3uQmYdBd`. Same PIT
# all consumer apps use. See SoT §1.
GHL_LOCATION_API_KEY=pit-...

# Stripe webhook signing secret. Created when Kashi adds the endpoint in
# Stripe Dashboard → Developers → Webhooks → click endpoint → Signing secret.
# Without it, /webhooks/stripe rejects every request 400.
STRIPE_WEBHOOK_SECRET=whsec_...

# Calendly webhook signing key. Generated and printed ONCE by
# scripts/setup-calendly-webhook.mjs (see §5b in the phase prompt).
# Without it, /webhooks/calendly rejects every request 400.
CALENDLY_WEBHOOK_SIGNING_KEY=

# Calendly Personal Access Token. Only needed locally when running
# scripts/setup-calendly-webhook.mjs to register the subscription.
# Not used at request time — do NOT set in the running webhook service.
CALENDLY_API_TOKEN=

# Optional Stripe Secret API key (sk_live_... or sk_test_...). Only used as a
# fallback in customer.subscription.deleted / invoice.payment_failed handlers
# when the contact can't be found by stripe_customer_id custom field — the
# handler then calls Stripe's customers API to recover an email and lookup
# in GHL by email instead. Webhook signature verification does NOT need this.
# STRIPE_API_KEY=

# Optional: override port. Railway injects PORT automatically; default 3000 locally.
# PORT=3000
